---
import { render } from 'astro:content';

import qrcode from 'qrcode-generator';

import CopyCode from '../components/CopyCode.astro';
import PrintArticle from '../components/PrintArticle.astro';
import Row from '../components/Row.astro';
import TableScroll from '../components/TableScroll.astro';
import {
  articleHref,
  author,
  formatDate,
  readingMinutes,
  topicColours,
  type Article,
} from '../lib/content';
import Base from './Base.astro';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { title, summary, date, updated, topic } = article.data;
const { Content } = await render(article);
const href = articleHref(article);
const hasCode = article.body?.includes('```');
/** Markdown tables are the only ones an article writes, and every row opens a line. */
const hasTable = /^\s*\|/m.test(article.body ?? '');
const articleUrl = new URL(href, Astro.site).href;

/**
 * A printed sheet has no link to follow, so it carries its own way back.
 * Built here rather than fetched, so the markup stays self-contained.
 */
const qr = qrcode(0, 'M');
qr.addData(articleUrl);
qr.make();
const qrSvg = qr.createSvgTag({ cellSize: 4, margin: 0, scalable: true });

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: summary,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  url: new URL(href, Astro.site).href,
  inLanguage: 'en-GB',
  author,
};
---

<Base
  title={title}
  description={summary}
  active="writing"
  canonical={href}
  type="article"
  structuredData={structuredData}
>
  <div class="shell">
    <Row>
      <Fragment slot="rail">
        <p class="ui topic">
          <span class="swatch" style={`background:${topicColours[topic]}`}></span>
          {topic}
        </p>
        <p class="meta">{formatDate(date)}</p>
        {updated && <p class="meta">Updated {formatDate(updated)}</p>}
        <p class="meta">{readingMinutes(article.body)} minute read</p>
      </Fragment>
      <h1 class="display">{title}</h1>
      <p class="lede head-lede">{summary}</p>
    </Row>
    <article class="doc head-gap"><Content /></article>
    <aside class="colophon" aria-hidden="true">
      <div class="qr" set:html={qrSvg} />
      <p class="colophon-text">
        Read this online, with working links:<br />
        <span class="colophon-url">{articleUrl}</span>
      </p>
    </aside>
  </div>
  <PrintArticle />
  {hasCode && <CopyCode />}
  {hasTable && <TableScroll />}
</Base>

<style>
  .topic {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .swatch {
    width: 20px;
    height: 12px;
  }

  .head-lede {
    margin-top: 20px;
  }

  .head-gap {
    margin-top: 56px;
  }
</style>
