---
/**
 * Two measures, three approaches. Both scales run 0-100, so the panels are
 * directly comparable: terminology leaps when the glossary arrives and then
 * flattens, while overall quality barely moves until the model is tuned.
 * The ochre bar in each panel marks the step that did the work.
 */
const panels = [
  {
    title: 'Terminology',
    detail: 'Glossary terms rendered correctly (%)',
    steps: [
      { label: 'Base model', value: 44.8 },
      { label: 'With glossary', value: 83.9, carried: true },
      { label: 'Fine-tuned', value: 89.7 },
    ],
  },
  {
    title: 'Quality of the French',
    detail: 'chrF++ against reference translations',
    steps: [
      { label: 'Base model', value: 61.86 },
      { label: 'With glossary', value: 64.27 },
      { label: 'Fine-tuned', value: 78.37, carried: true },
    ],
  },
];

const format = (value: number) => value.toFixed(1).replace(/\.0$/, '');
---

<figure class="split">
  <div class="panels">
    {
      panels.map((panel) => (
        <section>
          <p class="ui">{panel.title}</p>
          <p class="meta">{panel.detail}</p>
          <ol>
            {panel.steps.map((step) => (
              <li class:list={{ carried: step.carried }}>
                <p class="meta label">{step.label}</p>
                <div class="track">
                  <div class="bar" style={`--share:${step.value}%`} />
                  <span>{format(step.value)}</span>
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
  <figcaption class="meta">
    <strong>Figure 1</strong> The two techniques move different measures. A glossary fixes
    terminology, whilst fine-tuning improves the quality of the French. Both scales run 0-100. Synthetic data, 224 held-out
    records.
  </figcaption>
</figure>

<style>
  .split {
    grid-column: 1 / -1;
    margin: 0;
    padding-block: 24px;
  }

  .panels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gutter);
    margin-bottom: 32px;
  }

  section > .meta {
    margin-bottom: 20px;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 18px;
  }

  .label {
    margin-bottom: 6px;
  }

  .track {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: 12px;
  }

  .bar {
    width: var(--share);
    height: 20px;
    background: var(--sea);
  }

  .carried .bar {
    background: var(--ochre);
  }

  .track span {
    color: var(--ink);
    font: 500 16px/24px var(--font-sans);
    font-variant-numeric: tabular-nums;
  }

  .carried .track span {
    font-weight: 700;
  }

  figcaption strong {
    color: var(--ink);
    font-weight: 500;
  }

  @media (max-width: 899px) {
    .panels {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  /* A browser leaves backgrounds out of a printed page unless the reader ticks
     'Background graphics', which is off by default and absent altogether from
     the macOS print dialog - so a bar drawn as a fill prints as nothing at all.
     print-color-adjust tells the browser this fill carries meaning rather than
     decoration, which is the one thing that gets it onto paper either way. The
     bars are the chart's only content, so this is ink the sheet should spend.
     Greys rather than the screen's colours: these print on mono lasers, where
     a hue says nothing and the step that did the work needs to read darkest. */
  @media print {
    .bar {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
      background: #6b6b6b;
      outline: 1pt solid var(--ink);
      outline-offset: -1pt;
    }

    .carried .bar {
      background: var(--ink);
    }
  }
</style>
