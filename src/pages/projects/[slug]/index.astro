---
import { render } from 'astro:content';

import Row from '../../../components/Row.astro';
import Base from '../../../layouts/Base.astro';
import { author, getProjects, projectHref, type Project } from '../../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const { title, summary, kind, status, repo, language } = project.data;
const { Content } = await render(project);

const structuredData = repo
  ? {
      '@context': 'https://schema.org',
      '@type': 'SoftwareSourceCode',
      name: title,
      description: summary,
      url: new URL(projectHref(project), Astro.site).href,
      codeRepository: repo,
      programmingLanguage: language,
      author,
    }
  : undefined;
---

<Base title={title} description={summary} active="projects" structuredData={structuredData}>
  <div class="shell">
    <Row>
      <Fragment slot="rail">
        <p class="ui">{kind}</p>
        {status && <p class="meta">{status}</p>}
        {repo && <a class="ui" href={repo}>View source</a>}
      </Fragment>
      <h1 class="display">{title}</h1>
      <p class="lede lede-gap">{summary}</p>
    </Row>
    <div class="doc doc-gap"><Content /></div>
  </div>
</Base>

<style>
  .lede-gap {
    margin-top: 16px;
  }

  .doc-gap {
    margin-top: 56px;
  }
</style>
