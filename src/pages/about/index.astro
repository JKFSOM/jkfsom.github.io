---
import Row from '../../components/Row.astro';
import Base from '../../layouts/Base.astro';
import { site } from '../../lib/content';

const rows = [
  {
    label: 'Work',
    paragraphs: [
      'I build and operate technology businesses, working across product, engineering, marketing and operations.',
      'My background is in software engineering, with extensive experience building and operating production cloud systems. I work across both the technical and commercial sides of bringing products to market.',
    ],
  },
  {
    label: 'Focus',
    paragraphs: [
      'My work increasingly centres on applied AI, automation and the economics of software businesses.',
      'Current projects include AI agents for research and marketing, alongside broader work on marketplaces, distribution and business operations.',
    ],
  },
  {
    label: 'This site',
    paragraphs: [
      'A collection of writing, research and technical work covering software, AI, technology businesses and the systems behind them.',
      'I publish things I’ve built, investigated or found worth sharing.',
    ],
  },
];
---

<Base
  title="About"
  description="Building and operating technology businesses, across product, engineering, marketing and operations."
  active="about"
>
  <div class="shell page-end spaced--tight">
    <Row>
      <Fragment slot="rail" />
      <h1 class="display">About</h1>
    </Row>
    {
      rows.map((row) => (
        <Row minor label={row.label}>
          <h2 slot="rail" class="heading-3">
            {row.label}
          </h2>
          <div class="body">
            {row.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </Row>
      ))
    }
    <Row minor label="Contact">
      <h2 slot="rail" class="heading-3">Contact</h2>
      <p class="body"><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </Row>
  </div>
</Base>

<style>
  .body {
    display: grid;
    gap: 16px;
    max-width: 760px;
    font-size: 20px;
    line-height: 33px;
  }

  @media (max-width: 899px) {
    .body {
      font-size: 18px;
      line-height: 29px;
    }
  }
</style>
