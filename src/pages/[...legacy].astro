---
/** Serves articles at their original URLs, which GitHub Pages cannot redirect. */
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { getArticles, type Article } from '../lib/content';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles
    .filter((article) => article.data.legacyPath)
    .map((article) => ({
      params: { legacy: article.data.legacyPath!.slice(1, -'.html'.length) },
      props: { article },
    }));
}

const { article } = Astro.props as { article: Article };
---

<ArticleLayout article={article} />
